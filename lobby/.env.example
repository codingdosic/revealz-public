# Copy to lobby/.env (gitignored) and fill in. Do not commit secrets.
# Compose reads this file. POSTGRES_PASSWORD must match META_DATABASE_URL.

OPS_TOKEN=change-me-long-random
LOBBY_HTTP_PORT=8080
LOBBY_PUBLIC_HOST=127.0.0.1
WARM_POOL_SIZE=0

POSTGRES_DB=revealz_meta
POSTGRES_USER=revealz_meta
POSTGRES_PASSWORD=change-me

META_DATABASE_URL=postgres://revealz_meta:change-me@127.0.0.1:5432/revealz_meta
# Dedicated worker → lobby Meta (validate-deck). Same host as LOBBY_HTTP_PORT in local/docker.
META_LOBBY_URL=http://127.0.0.1:8080
# Client Godot: ProjectSettings revealz/lobby_base_url, or META_LOBBY_URL when headless.
# Shop prices/pools live in Postgres shop_products (ops/db); not in this env file.

WORKER_BIN=/app/export/revealz_server
PG_DUMP=pg_dump
PG_RESTORE=pg_restore
